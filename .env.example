# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (MongoDB Connection String)
# Supports either MONGO_URI or MONGODB_URI
MONGO_URI=mongodb://127.0.0.1:27017/projectcamp
MONGODB_URI=mongodb://127.0.0.1:27017/projectcamp

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Authentication & JWT Secrets (Use strong random strings for production)
ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_characters_long
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters_long
REFRESH_TOKEN_EXPIRY=10d

# SMTP / Mail Service (Mailtrap or standard SMTP for email verification and password resets)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_smtp_user
MAILTRAP_SMTP_PASS=your_smtp_password

# Frontend URL (For generating password reset redirect links)
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password

